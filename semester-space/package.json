  "engines": {
    "node": ">=20.16.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "5.4.624",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
